function init(self)
	msg.post("/hud#hud", "show_text", {speaker = "Narrator", text = "You have a date with an old friend. Sadly, since you are ovber 500 years old, you've forgotten how they look like. You need to find out."})
	timer.delay(8, false, function() 
		self.current = collectionfactory.create("/game#cafe", vmath.vector3(0, 0, 0))
		self.menu = nil
		msg.post("/hud#hud", "hide_text")
		msg.post("/hud#hud", "fade", {out = false})
	end)

end



function on_message(self, message_id, message, sender)
	if message_id == hash("unload") then
		if self.current then
			go.delete(self.current)
			self.current = nil
		end
		
		-- load new room as specified in tge message
		-- after loading room, set position of the vampire
	elseif message_id == hash("load") then
		local room = "/game#" .. message.room
		self.current = collectionfactory.create(room)
		if message.position then
			go.set_position(message.position, "/vampire")
		end

	elseif message_id == hash("switch")then
		msg.post("/hud#hud", "fade", { out = true })
		timer.delay(0.5, false, function() 
			msg.post("#", "unload")
			msg.post("#", "load", {room = message.room, position = message.position})
			msg.post("/hud#hud", "fade", {out=false})
		end)
		
	elseif message_id == hash("end") then
		msg.post("/vampire", "disable")
		msg.post("/hud#hud", "fade", { out = true })
		msg.post("/hud#hud", "show_text", {speaker = "Narrator", text = "You finally found your friend. Now you can have a nice talk and catch up. Good Job!"})
		timer.delay(8, false, function() msg.post("@system:", "exit", {code = 0}) end)
		
	end
end

