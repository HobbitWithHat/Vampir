go.property("dark", false)

function init(self)
	sound.play("#bgm")
	if self.dark then
		msg.post("/hud#hud", "dark", { dark = true })
	end
end

function final(self)
	sound.stop("#bgm")
	if self.dark then
		msg.post("/hud#hud", "dark", { dark = false })
	end

end

function on_message(self, message_id, message, sender)
	if message_id == hash("fadeout") then
		go.animate("#bgm", "gain", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_OUTSINE , 1)
	end
end