go.property("open", false)

function init(self)
	if self.open == false then
		sprite.play_flipbook("#sprite_tl", "cdoor_c1")
		sprite.play_flipbook("#sprite_tr", "cdoor_c2")
		sprite.play_flipbook("#sprite_bl", "cdoor_c3")
		sprite.play_flipbook("#sprite_br", "cdoor_c4")
	else
		sprite.play_flipbook("#sprite_tl", "cdoor_o1")
		sprite.play_flipbook("#sprite_tr", "cdoor_o2")
		sprite.play_flipbook("#sprite_bl", "cdoor_o3")
		sprite.play_flipbook("#sprite_br", "cdoor_o4")
	end


	self.text = false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("interact") then
		if self.open then					-- is door open?
			print("go through")				-- if open, go through
			msg.post("/game#main", "switch", {room = "cellar2", position = vmath.vector3(0, 56, 0.1)})
		else
			if message.stuff["key"] then	-- if closed, but has key, open door
				sprite.play_flipbook("#sprite_tl", "cdoor_o1")
				sprite.play_flipbook("#sprite_tr", "cdoor_o2")
				sprite.play_flipbook("#sprite_bl", "cdoor_o3")
				sprite.play_flipbook("#sprite_br", "cdoor_o4")
				self.open = true
			else							-- if closed and without key
				if self.text then			-- if text shown, hide text
					msg.post("/hud#hud", "hide_text")
					self.text = false
				else						-- if no text, then show text
					msg.post("/hud#hud", "show_text", {speaker = "Vampir", text = ("It's locked. I need the cellar key")})
					self.text = true
				end
			end
		end
	elseif message_id == hash("trigger_response") then	-- go away to close text
		if message.enter == false then
			msg.post("/hud#hud", "hide_text")
			self.text = false
		end
	end
end
