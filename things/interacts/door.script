	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("interact") then
		if message.stuff["key"] then
			sprite.play_flipbook("#sprite_tl", "cdoor_o1")
			sprite.play_flipbook("#sprite_tr", "cdoor_o2")
			sprite.play_flipbook("#sprite_bl", "cdoor_o3")
			sprite.play_flipbook("#sprite_br", "cdoor_o4")
			self.open = true
		else
			if self.text then
				msg.post("/hud#hud", "hide_text")
				self.text = false
			else
				msg.post("/hud#hud", "show_text", { text = ("It's locked. I need the cellar key")})
				self.text = true
			end
		end
	elseif message_id == hash("trigger_response") then
		if message.enter == false then
			msg.post("/hud#hud", "hide_text")
			self.text = false
		end
	end
end

