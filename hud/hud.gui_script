function init(self)
	self.background = gui.get_node("textbox_background")
	--self.border = gui.get_node("textbox_border")
	self.text = gui.get_node("textbox_text")
	self.fog = gui.get_node("fog")
	self.speaker = gui.get_node("speaker_text")
	self.hint = gui.get_node("hint")
	self.hinttext = gui.get_node("hint_text")
	self.notice = gui.get_node("notice")
	self.noticetext = gui.get_node("notice_text")
	self.dark = gui.get_node("dark")
	self.exhibit = gui.get_node("exhibit")


	gui.set_visible(self.background, false)
	--gui.set_visible(self.border, false)
	gui.set_visible(self.text, false)
	gui.set_visible(self.speaker, false)
	gui.set_visible(self.notice, false)
	gui.set_visible(self.noticetext, false)
	gui.set_alpha(self.fog, 1)
end



function on_message(self, message_id, message, sender)
	if message_id == hash("show_text") then
		gui.set_text(self.text, message.text)
		gui.set_text(self.speaker, message.speaker)
		gui.set_visible(self.background, true)
		--gui.set_visible(self.border, true)
		gui.set_visible(self.text, true)
		gui.set_visible(self.speaker, true)

	elseif message_id == hash("hide_text") then
		gui.set_visible(self.background, false)
		--gui.set_visible(self.border, false)
		gui.set_visible(self.text, false)
		gui.set_visible(self.speaker, false)

	elseif message_id == hash("show_hint") then
		gui.set_visible(self.hint, true)
		gui.set_visible(self.hinttext, true)

	elseif message_id == hash("hide_hint") then
		gui.set_visible(self.hint, false)
		gui.set_visible(self.hinttext, false)

	elseif message_id == hash("notice") then
		local text = message.name .. " collected"
		gui.set_text(self.noticetext, text)
		gui.set_visible(self.notice, true)
		gui.set_visible(self.noticetext, true)
		timer.delay(2, false, function()
			gui.set_visible(self.notice, false)
			gui.set_visible(self.noticetext, false)
		end)

	elseif message_id == hash("fade") then
		if message.out then
			gui.animate(self.fog, gui.PROP_COLOR, vmath.vector4(0,0,0,1), gui.EASING_LINEAR, 0.5)
		else
			gui.animate(self.fog, gui.PROP_COLOR, vmath.vector4(0,0,0,0), gui.EASING_LINEAR, 0.5)
		end
		
	elseif message_id == hash("dark") then
		if message.dark then
			gui.set_alpha(self.dark, 0.5)
		else
			gui.set_alpha(self.dark, 0)
		end

	elseif message_id == hash("show_exhibit") then
		gui.set_texture(self.exhibit, "exhibits")
		gui.play_flipbook(self.exhibit, message.pic)
		gui.set_scale(self.exhibit, vmath.vector3(message.scale,message.scale,message.scale))
		--gui.animate(self.dark, gui.PROP_COLOR, vmath.vector4(0,0,0,0.5), gui.EASING_LINEAR, 0.5)
		gui.animate(self.exhibit, gui.PROP_COLOR, vmath.vector4(1,1,1,1), gui.EASING_LINEAR, 0.5)
		gui.animate(self.exhibit, gui.PROP_POSITION, vmath.vector3(640,360,0.5), gui.EASING_LINEAR, 0.5)

	elseif message_id == hash("hide_exhibit") then
		--gui.animate(self.dark, gui.PROP_COLOR, vmath.vector4(0,0,0,0), gui.EASING_LINEAR, 0.5)
		gui.animate(self.exhibit, gui.PROP_COLOR, vmath.vector4(0,0,0,0), gui.EASING_LINEAR, 0.5)
		gui.animate(self.exhibit, gui.PROP_POSITION, vmath.vector3(640,300,0.5), gui.EASING_LINEAR, 0.5)
		
	end
end
