local function close(self)
	msg.post("/vampire", "enable")
	gui.animate(self.background, "position.x", -640, gui.EASING_OUTSINE, 1)
	gui.animate(self.background, gui.PROP_COLOR, vmath.vector4(1, 1, 1, 0), gui.EASING_LINEAR, 1)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.background = gui.get_node("background")
	self.cafe = gui.get_node("cafe_button")
	self.cellar = gui.get_node("cellar_button")
	self.girl = gui.get_node("girl_button")
	self.alley = gui.get_node("alley_button")
	self.student = gui.get_node("student_button")
	self.janitor = gui.get_node("janitor_button")
	self.roof = gui.get_node("roof_button")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("transition") then
		gui.animate(self.background, "position.x", 640, gui.EASING_OUTSINE, 1)
		gui.animate(self.background, gui.PROP_COLOR, vmath.vector4(1, 1, 1, 1), gui.EASING_LINEAR, 0.5)
		
		-- start timer (1s, until animation end)
		-- Call a simple function to post messages, after timer is done
		timer.delay(1, false, function() 
			msg.post("/vampire", "disable")
			msg.post("/game#main", "unload") 
								end)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("touch") then
		if gui.pick_node(self.cafe, action.x, action.y) and action.pressed then
			msg.post("/game#main", "load", { room = "cafe", position = vmath.vector3(-50, -30, 0.1) })
			close(self)
		elseif gui.pick_node(self.cellar, action.x, action.y) and action.pressed then
			msg.post("/game#main", "load", {room = "cellar", position = vmath.vector3(0, -20, 0.1)})
			close(self)
		elseif gui.pick_node(self.girl, action.x, action.y) and action.pressed then
			msg.post("/game#main", "load", {room = "girl", position = vmath.vector3(50, 60, 0.1)})
			close(self)		
		elseif gui.pick_node(self.alley, action.x, action.y) and action.pressed then
			msg.post("/game#main", "load", {room = "alley", position = vmath.vector3(8, 40, 0.1)})
			close(self)
		elseif gui.pick_node(self.student, action.x, action.y) and action.pressed then
			msg.post("/game#main", "load", {room = "student", position = vmath.vector3(-50, 16, 0.1)})
			close(self)
		elseif gui.pick_node(self.janitor, action.x, action.y) and action.pressed then
			msg.post("/game#main", "load", {room = "janitor", position = vmath.vector3(-20, 0, 0.1)})
			close(self)
		elseif gui.pick_node(self.roof, action.x, action.y) and action.pressed then
			msg.post("/game#main", "load", {room = "roof", position = vmath.vector3(130, 24, 0.1)})
			close(self)
		end
	end
end
