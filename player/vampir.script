
local function blood(self, value)
	if value >= 90 then
		return "10"
	elseif value >= 80 then
		return "9"
	elseif value >= 70 then
		return "8"
	elseif value >= 60 then
		return "7"
	elseif value >= 50 then
		return "6"
	elseif value >= 40 then
		return "5"
	elseif value >= 30 then
		return "4"
	elseif value >= 20 then
		return "3"
	elseif value >= 10 then
		return "2"
	elseif value >= 0 then
		return "1"
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.blood = 100
	self.object = nil

	self.speed = 75

	self.dir = vmath.vector3()
	self.correction = vmath.vector3()
	self.pp = vmath.vector3()
	self.transition = false

	self.current_body = hash("idle")
	self.current_head = hash("head_center")

	sprite.play_flipbook("#body", self.current_body)
	sprite.play_flipbook("#head", self.current_head)

	-- sammelbare Items und Stats
	self.stuff = {
		info = false,
		coffee = false,
		cologne = false,
		key = false,
		book = false,
		juice = false,
		doll = false,
		tantrum = false,
		coin = false,
	}

	
end

function update(self, dt)
	self.correction = vmath.vector3()

	local head = self.current_head
	local body = self.current_body
	

	-- normiert den Bewegungsvektor
	if vmath.length(self.dir) > 1 then
		self.dir = vmath.normalize(self.dir)
	end
	--Updated Spieler Position
	local p = go.get_position()
	local new_p = p + self.dir * self.speed * dt
	go.set_position(new_p)

	-- Depending on the direction vector change it to a proper animation:
	if self.dir.x > 0 then
		body = hash("walk_right")
		head = hash("head_right")
	elseif self.dir.x < 0 then
		body = hash("walk_left")
		head = hash("head_left")
	elseif self.dir.y > 0 then
		body = hash("walk_straight")
		head = hash("head_center")
	elseif self.dir.y < 0 then
		body = hash("walk_straight")
		head = hash("head_center")

	elseif self.dir.x == 0 and self.dir.y == 0 then
		body = hash("idle")
		head = hash("head_center")
	end


	-- if the animation we decided to play is different from the xurrent one playing:
	if self.current_head ~= head then 
		sprite.play_flipbook("#head", head) -- Play the new Animation
		self.current_head = head -- an update the variable tracking the current nimation
	end
	
	if self.current_body ~= body then
		sprite.play_flipbook("#body", body) -- Play the new Animation
		self.current_body = body -- an update the variable tracking the current nimation
	end

	self.dir = vmath.vector3()
	
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		-- Get the info needed to move out of collision. We might
		-- get several contact points back and have to calculate
		-- how to move out of all of them by accumulating a
		-- correction vector for this frame:
		if message.distance > 0 then
			-- First, project the accumulated correction onto
			-- the penetration vector
			local proj = vmath.project(self.correction, message.normal * message.distance)
			if proj < 1 then
				-- Only care for projections that does not overshoot.
				local comp = (message.distance - message.distance * proj) * message.normal
				-- Apply compensation
				go.set_position(go.get_position() + comp)
				-- Accumulate correction done
				self.correction = self.correction + comp
			end
		end

		-- detecting collided object and remembers it
		-- important for interacting with the last collided object
	elseif message_id == hash("trigger_response") then
		if message.enter then
			self.object = message.other_id
		else
			self.object = nil
		end	

	elseif message_id == hash("collect") then
		self.stuff[message.item] = true

	
	end
end

function on_input(self, action_id, action)
	
	-- Bewegung, Figur läuft per Tastatur in Richtungen
	if action_id == hash("up") then
		self.dir.y = 1
	elseif action_id == hash("down") then
		self.dir.y = -1
	elseif action_id == hash("left") then
		self.dir.x = -1
	elseif action_id == hash("right") then
		self.dir.x = 1
		
	elseif action_id == hash("interact") and action.pressed and self.object then
		msg.post(self.object, "interact", { stuff = self.stuff })
	end
end
